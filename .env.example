PORT=3210
PUID=1000
PGID=1000
EASYX_DATA_DIR=/data
EASYX_MEDIA_DIR=/media
EASYX_EXTERNAL_PLUGINS_DIR=/plugins
EASYX_LOG_LEVEL=info
# Full library reconciliation, measured after the previous scan finishes.
# Completed downloads are indexed individually as soon as they are stored.
EASYX_SCAN_INTERVAL_MINUTES=60

# Server ceiling for the Maximum concurrent downloads setting (positive integer).
EASYX_MAX_CONCURRENT_DOWNLOADS_LIMIT=8
# Wait for short live interruptions before finalizing an MP4; 0 disables merging.
STRIPCHAT_MERGE_GAP_MINUTES=10
CAM4_MERGE_GAP_MINUTES=10
BONGACAMS_MERGE_GAP_MINUTES=10
